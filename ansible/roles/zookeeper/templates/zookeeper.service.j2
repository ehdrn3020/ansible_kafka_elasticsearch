[Unit]
Description=Apache Zookeeper 3.7.2
Documentation=http://zookeeper.apache.org
Requires=network.target remote-fs.target
After=network.target remote-fs.target

[Service]
Type=simple
User={{ zookeeper_user }}
Group={{ zookeeper_group }}
WorkingDirectory={{ zookeeper_home }}
Environment="JAVA_HOME={{ java_home }}"
Environment="ZOO_LOG_DIR={{ zookeeper_log_dir }}"
Environment="SERVER_JVMFLAGS=-Xms512m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=20 -XX:InitiatingHeapOccupancyPercent=35"
# Environment="JVMFLAGS=-javaagent:{{ jmx_exporter_dir }}/{{ jmx_exporter_file_name }}={{ jmx_exporter_zookeeper_port }}:{{ jmx_exporter_dir }}/zookeeper.yml"

ExecStart={{ zookeeper_home }}/bin/zkServer.sh start-foreground {{ zookeeper_home }}/conf/zoo.cfg
Restart=on-failure
RestartSec=2
TimeoutSec=90
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
